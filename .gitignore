# Runtime state is local only. Keep the four storage buckets in the repository.
/storage/*
!/storage/database/
!/storage/uploads/
!/storage/outputs/
!/storage/temp/
/storage/database/*
/storage/uploads/*
/storage/outputs/*
/storage/temp/*
