# Copy this file to .env beside README.md and fill in your key.
# .env is local plaintext; do not share or commit it.
OPENAI_API_KEY=YOUR_API_KEY

# Optional defaults for new projects:
# STORY_LLM_MODEL=gpt-6.1-sol

# Optional video rendering settings (USD per generated video second):
# STORY_VIDEO_COST_PER_SECOND=0.10
# STORY_RENDER_TIMEOUT_SEC=1800
# STORY_FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# Admin key used only to read OpenAI billed costs (separate from generation key).
OPENAI_ADMIN_KEY=
# Optional: choose the organization used for billing reports.
# OPENAI_ORG_ID=org_your_organization_id

# Main production credentials (Runway: Kling O3 Pro, Gen-4 Image, Act-Two):
RUNWAYML_API_SECRET=
ELEVENLABS_API_KEY=
# STORY_IMAGE_PROVIDER=runway
# STORY_IMAGE_MODEL=gen4_image
# STORY_TTS_PROVIDER=elevenlabs
# STORY_TTS_MODEL=eleven_v4
# STORY_NARRATOR_VOICE=your_elevenlabs_voice_id

# Optional USD estimates: set STORY_SFX_COST_PER_SECOND to your numeric provider/model rates.
# STORY_MUSIC_COST_PER_MINUTE=0.30
# Leave rates unset to show Unknown rather than an assumed zero cost.

# Provider-specific estimates; leave blank/unset for Unknown. Do not reuse OpenAI rates.
# STORY_RUNWAY_IMAGE_COST_PER_IMAGE=
# STORY_RUNWAY_VIDEO_COST_PER_SECOND=
# STORY_ACT_TWO_COST_PER_SECOND=
# STORY_ELEVENLABS_TTS_COST_PER_MILLION_CHARACTERS=
